<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Polaris paper intraday cron — 15min interval, universe top 30, intraday strategies.

  Setup:
    cp scripts/com.polaris.paper.intraday.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.polaris.paper.intraday.plist

  Logs: data/paper/intraday.{log,err}
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polaris.paper.intraday</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jinyoon/Projects/Polaris/.venv/bin/python</string>
        <string>-m</string>
        <string>src.paper.intraday_cron</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/jinyoon/Projects/Polaris</string>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/jinyoon/Projects/Polaris/data/paper/intraday.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jinyoon/Projects/Polaris/data/paper/intraday.err</string>
</dict>
</plist>
