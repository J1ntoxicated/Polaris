{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:api.openai.com)",
      "WebFetch(domain:generativelanguage.googleapis.com)",
      "WebFetch(domain:www.okx.com)",
      "WebFetch(domain:alpaca.markets)",
      "Skill(update-config)",
      "Skill(superpowers:*)",
      "Skill(codex:*)",
      "Skill(polaris:*)",
      "Bash(python3 tools/vault_lint.py:*)",
      "Bash(python3 .claude/hooks/*.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_agent.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post_edit.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post_stop.py"
          }
        ]
      }
    ]
  },
  "polaris": {
    "vault_first_cycle": true,
    "emergency_bypass_window_hours": 24,
    "adr_proposed_max_days": 7,
    "code_review_external_only": true,
    "harness_modes": ["DEV", "ALPHA", "FORENSIC", "DEBATE"],
    "min_backlinks_knowledge": 2,
    "spec_dir": "docs/superpowers/specs",
    "plan_dir": "docs/superpowers/plans"
  }
}
