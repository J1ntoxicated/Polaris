<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Polaris paper trading daily cron (macOS launchd).

  Setup (manual, Jin):
  1. Verify .venv exists: ls /Users/jinyoon/Projects/Polaris/.venv/bin/python
  2. Copy plist:
       cp scripts/com.polaris.paper.daily.plist ~/Library/LaunchAgents/
  3. Load:
       launchctl load ~/Library/LaunchAgents/com.polaris.paper.daily.plist
  4. Verify next run:
       launchctl list | grep polaris

  Unload:
       launchctl unload ~/Library/LaunchAgents/com.polaris.paper.daily.plist

  Logs: data/paper/cron.{log,err}
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.polaris.paper.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/jinyoon/Projects/Polaris/.venv/bin/python</string>
        <string>-m</string>
        <string>src.paper.cron</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/jinyoon/Projects/Polaris</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>1</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/jinyoon/Projects/Polaris/data/paper/cron.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jinyoon/Projects/Polaris/data/paper/cron.err</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
