# ═══════════════════════════════════════════════
#  Auto Invasion Trading Bot - Configuration
# ═══════════════════════════════════════════════

# ── OKX Exchange (Crypto Bot) ──
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase
OKX_DEMO=true

# ── IG Markets (Forex Bot) ──
IG_API_KEY=your_ig_api_key
IG_USERNAME=your_ig_username
IG_PASSWORD=your_ig_password
IG_ACC_NUMBER=your_ig_account_number
IG_DEMO=true

# ── AI Advisor (Optional) ──
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_ENABLED=true
AI_DAILY_BUDGET=1.0
AI_MONTHLY_BUDGET=10.0

# Model names (change to latest available)
AI_TIER1_MODEL=gpt-4o-mini
AI_TIER2_GPT=gpt-4o
AI_TIER2_CLAUDE=claude-haiku-4-5-20251001
AI_TIER3_CLAUDE=claude-opus-4-6

# ── General ──
LOG_LEVEL=INFO
