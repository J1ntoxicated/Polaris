{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebSearch",
      "WebFetch",
      "WebFetch(domain:*)",
      "Skill(*)",
      "Read(//**)",
      "mcp__sequential-thinking__sequentialthinking",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__sqlite__read_query",
      "mcp__duckdb__query",
      "mcp__obsidian-mcp__*",
      "mcp__time__*",
      "mcp__ccxt__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/session_end.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_tool_use.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/post_tool_use.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/user_prompt_submit.py"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "ccxt": {
      "command": "npx",
      "args": ["-y", "@lazydino/ccxt-mcp"]
    },
    "sqlite": {
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "${CLAUDE_PROJECT_DIR}/data/polaris.sqlite"]
    },
    "duckdb": {
      "command": "uvx",
      "args": ["mcp-server-motherduck", "--db-path", "${CLAUDE_PROJECT_DIR}/data/polaris_analytics.duckdb"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "obsidian-mcp": {
      "command": "npx",
      "args": ["-y", "@bitbonsai/mcpvault"],
      "env": {
        "OBSIDIAN_VAULT_PATH": "${CLAUDE_PROJECT_DIR}/vault"
      }
    },
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time", "--local-timezone=Australia/Sydney"]
    }
  },
  "polaris": {
    "vault_first_cycle": true,
    "harness_modes": {
      "base_modes": ["dev", "alpha", "forensic"],
      "overlay_modes": ["debate"],
      "hard_exclusive_base": true
    },
    "posture": "aggressive",
    "demo_only": true,
    "auto_stop": false,
    "vault_lint": {
      "light_pre_commit": true,
      "heavy_weekly_cron": true,
      "tool": "tools/vault_lint.py"
    },
    "collaboration": {
      "spec": "vault/30_components/harness-collab-protocol.md",
      "main_role": "orchestrator_synthesizer",
      "builder_not_reviewer": true,
      "primary_reviewer": "claude_subagent",
      "reviewer_fallback": "claude_subagent",
      "dev_gpt_disabled": "Jin 2026-05-31: no GPT/codex for DEV (review/debate) — cost. Bot LLM=GPT is fine. Cross-verify via fresh Claude subagents only.",
      "review_required_for": ["new_code", "behavior_change", "spec", "rule"],
      "big_wave_review_axes": ["technical", "policy", "coherence", "functional", "live_audit"],
      "super_brain_4": ["vault_read", "sequential_thinking", "claude_subagent_debate", "vault_update"],
      "agent_is": "autonomous_executor (independent_context + full_toolkit); tool/skill/advisor_call_alone != agent",
      "dispatch_triggers": ["rejection_keyword_sweep_hit", "ninestack_or_sizing_change", "vault_write_conflict", "new_code_or_behavior_change", "five_plus_file_read", "codebase_wide_search", "big_wave_audit"],
      "handoff_pollution_signals": ["read_5plus", "grep_100plus_lines", "repeated_axis_search"],
      "review_gate_enabled": false
    }
  },
  "model": "claude-fable-5",
  "outputStyle": "default",
  "spinnerTipsEnabled": false,
  "prefersReducedMotion": true
}
